#!/usr/bin/env python3

import json
import sys
import subprocess
import hashlib

# Accepts as stdin a JSON object in the format of images.json.
# And adds some calculatble elements used during the build.
#
# 1. Resolves any 'ref' values in the JSON to a revision sha. A 'ref' may be a
#    single ref or an array of refs, in which case the first ref that exists in
#    the repo is used, and 'ref' is replaced with it. With --no-fallback only
#    the first ref of an array is tried.
# 2. Hashes the entire dep details and injects the hash as an id into the deps
#    details. The id can be used to uniquely identify a dep configuration.
#
# Outputs the original JSON modified.
#
# Usage: < images.json ./.scripts/images-with-extras [--no-fallback]

no_fallback = "--no-fallback" in sys.argv[1:]

images = json.load(sys.stdin)

cache = {}

def resolve(repo, ref):
    """Return the sha ref points to in repo, or None if the ref does not exist."""
    result = subprocess.run(
        ["gh", "api", f"repos/{repo}/commits/{ref}", "--jq", ".sha"],
        capture_output=True,
        text=True,
    )
    if result.returncode == 0:
        return result.stdout.strip()
    # GitHub responds 422 (or 404) when no commit matches the ref.
    if "(HTTP 422)" in result.stderr or "(HTTP 404)" in result.stderr:
        return None
    print(result.stderr, file=sys.stderr)
    sys.exit(1)

for image in images:
    tag = image["tag"]
    for dep in image["deps"]:
        name = dep["name"]
        repo = dep["repo"]
        refs = dep["ref"] if isinstance(dep["ref"], list) else [dep["ref"]]
        if no_fallback:
            refs = refs[:1]
        print(f"{tag} {name} {repo} {refs} ...", file=sys.stderr)
        for ref in refs:
            key = (name, repo, ref)
            if key not in cache:
                cache[key] = resolve(repo, ref)
            sha = cache[key]
            if sha:
                break
            print(f" • ref {ref} not found", file=sys.stderr)
        else:
            print(f"Error: {tag} {name}: none of the refs {refs} exist in {repo}", file=sys.stderr)
            sys.exit(1)
        print(f" • ref = {ref}", file=sys.stderr)
        print(f" • revision sha = {sha}", file=sys.stderr)
        dep["ref"] = ref
        dep["sha"] = sha

        dep_str = json.dumps(dep, separators=(',', ':'))
        id = hashlib.sha256(dep_str.encode()).hexdigest()
        dep["id"] = id
        print(f" • id = {id}", file=sys.stderr)

print(json.dumps(images, separators=(',', ':')))
